# Maven build output
target/

# IDE files
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs and heap dumps
logs/
*.log
*.hprof

# Credentials — never commit these
*.env
*.pem
*.key

# Terraform — state can contain secrets in plaintext
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
